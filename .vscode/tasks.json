{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Incremental build",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean build",
            "type": "shell",
            "command": "make clean all",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
